Options -Indexes

# Allow access to api folder
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # API routing - forward all /api requests to api/index.php
    RewriteCond %{REQUEST_URI} ^/appdev/edonation/api
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
</IfModule>

<Files .htaccess>
  Order allow,deny
  Deny from all
</Files>

