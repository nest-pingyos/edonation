# Environment Configuration for TEST
# URL: https://app.nurse.cmu.ac.th/appdeb/edonation

APP_ENV=testing
APP_DEBUG=true
APP_URL=https://app.nurse.cmu.ac.th/appdeb/edonation

# Database (ใช้ DB เดียวกันหรือ DB ทดสอบ)
