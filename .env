# eDonation Environment Configuration
# Copy this file to .env and configure your values
# Last updated: 2025-12-20

# ===========================================
# Application Settings
# ===========================================
# development | production
APP_ENV=development
APP_DEBUG=true

# Production: https://app.nurse.cmu.ac.th/edonation
# Development: http://localhost/appdev/edonation
APP_URL=http://localhost/appdev/edonation
BASE_PATH=/appdev/edonation

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=edonation
DB_USER=root
DB_PASS=

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
# Get token from https://notify-bot.line.me/
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
# Use App Password for Gmail
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=
