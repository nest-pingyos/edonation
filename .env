# eDonation Environment Configuration
# Last updated: 2026-02-02

# ==============================================================================
# 1. Environment Presets (เลือกใช้อย่างใดอย่างหนึ่ง)
# ==============================================================================

# --- [SETTING A] Local XAMPP (Default) ---
APP_ENV=development
APP_DOMAIN=http://localhost
BASE_PATH=/edonation
# Callback: http://localhost/edonation/admin/src/auth-callback.php

# --- [SETTING B] Docker Testing ---
# APP_ENV=development
# APP_DOMAIN=http://localhost:8080
# BASE_PATH=
# Callback: http://localhost:8080/admin/src/auth-callback.php

# --- [SETTING C] Production (Nurse App) ---
# APP_ENV=production
# APP_DOMAIN=https://app.nurse.cmu.ac.th
# BASE_PATH=/edonation
# Callback: https://app.nurse.cmu.ac.th/edonation/admin/src/auth-callback.php

# ==============================================================================
# 2. Application Core Settings
# ==============================================================================
APP_DEBUG=true
API_BASE_PATH=${BASE_PATH}/api

# Full URLs (Auto-generated by system)
APP_URL=${APP_DOMAIN}${BASE_PATH}
API_URL=${APP_DOMAIN}${API_BASE_PATH}

# ==============================================================================
# 3. Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_NAME=donation
DB_USER=root
DB_PASS=

# ==============================================================================
# 4. Security & Authentication
# ==============================================================================
JWT_SECRET=your-dev-secret-key-for-edonation-2025
JWT_EXPIRE=86400

# CMU OAuth / Microsoft Entra ID
# ต้องลงทะเบียน Redirect URI ที่ Azure Portal ให้ตรงกับ Environment ที่เลือกด้านบน
CMU_OAUTH_CLIENT_ID=9ff50902-00e4-482f-b3d0-f0d59d31c999
CMU_OAUTH_CLIENT_SECRET=P4R8Q~8SGCFrHRbPCTMJ3OcAr6y9lNuF35PUTb-b
