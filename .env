# eDonation XAMPP Environment
# For local development with XAMPP
# Last updated: 2026-02-03

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
# For XAMPP, app runs in subdirectory
APP_DOMAIN=http://localhost
API_DOMAIN=http://localhost
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# ===========================================
# Database Configuration
# ===========================================
# Update these to match your XAMPP MySQL settings
DB_HOST=localhost
DB_NAME=donation
DB_USER=root
DB_PASS=
MYSQL_ROOT_PASSWORD=

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=xampp-dev-secret-change-in-production
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=

# ===========================================
# CMU OAuth Configuration
# ===========================================
CMU_OAUTH_CLIENT_ID=
CMU_OAUTH_CLIENT_SECRET=
CMU_OAUTH_TENANT_ID=
