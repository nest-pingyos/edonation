# eDonation XAMPP Environment
# For local development with XAMPP
# Last updated: 2026-02-03

# ===========================================
# Application Settings
# ===========================================
APP_ENV=production
APP_DEBUG=false

# ===========================================
# Domain & URL Configuration
# ===========================================
# For XAMPP, app runs in subdirectory
APP_DOMAIN=https://app.nurse.cmu.ac.th
API_DOMAIN=https://app.nurse.cmu.ac.th
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# ===========================================
# Database Configuration
# ===========================================
# Update these to match your XAMPP MySQL settings
DB_HOST=localhost
DB_NAME=donation
DB_USER=edonation
DB_PASS=edoante@FON
MYSQL_ROOT_PASSWORD=

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=dhURRrTfvkT/PKmLFdoJlOz3UDbhPOlfSbZwYxrnMEg=
JWT_EXPIRE=86400

# ===========================================
