# eDonation Environment Configuration
# Copy this file to .env and configure your values
# Last updated: 2025-12-23

# ===========================================
# Application Settings
# ===========================================
# development | production
APP_ENV=development
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
APP_DOMAIN=http://localhost
API_DOMAIN=http://localhost

# สำหรับ XAMPP Mac ใช้ path นี้
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# Full URLs (auto-generated)
APP_URL=${APP_DOMAIN}${BASE_PATH}
API_URL=${API_DOMAIN}${API_BASE_PATH}

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=donation
DB_USER=root
DB_PASS=

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-dev-secret-key-for-edonation-2025
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=

# ===========================================
# CMU OAuth Configuration (Microsoft Entra)
# ===========================================
CMU_OAUTH_CLIENT_ID=9ff50902-00e4-482f-b3d0-f0d59d31c999
