# eDonation XAMPP Environment
# For local development with XAMPP
# Last updated: 2026-02-03

# ===========================================
# Application Settings
# ===========================================
APP_ENV=local
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
# For XAMPP, app runs in subdirectory
# For Docker, app runs on localhost:8080
APP_DOMAIN=http://localhost
API_DOMAIN=http://localhost
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# ===========================================
# Database Configuration
# ===========================================
# When running inside Docker, use 'db' as the host.
# When running from host (XAMPP/DBeaver), use '127.0.0.1' or 'localhost'.
DB_HOST=127.0.0.1
DB_NAME=donation
DB_USER=root
DB_PASS=root
MYSQL_ROOT_PASSWORD=root

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=dhURRrTfvkT/PKmLFdoJlOz3UDbhPOlfSbZwYxrnMEg=
JWT_EXPIRE=86400

# ===========================================
# CMU Nursing Messaging API (Internal)
