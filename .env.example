# eDonation Docker Environment Example
# Copy this file to .env and adjust values for your environment

# ===========================================
# Application Settings
# ===========================================
APP_ENV=local
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
# When running on Docker with default docker-compose.yml
APP_DOMAIN=http://localhost:8080
API_DOMAIN=http://localhost:8080
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# ===========================================
# Database Configuration
# ===========================================
# Connection from within Docker container
DB_HOST=db
DB_NAME=donation
DB_USER=root
DB_PASS=root
MYSQL_ROOT_PASSWORD=root

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure key for production
JWT_SECRET=your_secure_random_key_here
JWT_EXPIRE=86400

# ===========================================
# CMU Nursing Messaging API (Internal)
# ===========================================
# Notifications are handled via Faculty of Nursing's custom API.

# ===========================================
# SCB PromptPay Configuration (Optional)
# ===========================================
SCB_BILLER_ID=099400258783792
SCB_API_KEY=your_scb_api_key
SCB_API_SECRET=your_scb_api_secret

# ===========================================
# CMU OAuth Configuration (Optional)
# ===========================================
CMU_OAUTH_CLIENT_ID=your_client_id
CMU_OAUTH_CLIENT_SECRET=your_client_secret
CMU_OAUTH_TENANT_ID=your_tenant_id
