# eDonation Environment Configuration
# Copy this file to .env and configure your values
# Last updated: 2025-12-23

# ===========================================
# Application Settings
# ===========================================
# development | production
APP_ENV=development
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
# Web/Admin Domain (where web and admin are hosted)
# Production: https://app.nurse.cmu.ac.th
# Development: http://localhost
APP_DOMAIN=http://localhost

# API Domain (can be same or different from app domain)
# Production: https://api.nurse.cmu.ac.th (if separate) or same as APP_DOMAIN
# Development: http://localhost
API_DOMAIN=http://localhost

# Base path for Web/Admin (path after domain)
# Production: /edonation
# Development: /appdev/edonation
BASE_PATH=/appdev/edonation

# API base path (path after API_DOMAIN)
# Production: /edonation/api (if same domain) or /api (if separate)  
# Development: /appdev/edonation/api
API_BASE_PATH=/appdev/edonation/api

# Full URLs (auto-generated from above, but can override)
APP_URL=${APP_DOMAIN}${BASE_PATH}
API_URL=${API_DOMAIN}${API_BASE_PATH}

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=edonation
DB_USER=root
DB_PASS=

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
# Get token from https://notify-bot.line.me/
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
# Use App Password for Gmail
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=
