# eDonation Docker Environment
# Copy this file to .env when running with Docker
# Last updated: 2026-02-01

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_DEBUG=true

# ===========================================
# Domain & URL Configuration
# ===========================================
# For Docker, app runs at root
APP_DOMAIN=http://localhost:8080
API_DOMAIN=http://localhost:8080
BASE_PATH=
API_BASE_PATH=/api

# ===========================================
# Database Configuration
# ===========================================
# These match docker-compose.yml defaults
DB_HOST=db
DB_NAME=edonation
DB_USER=edonation
DB_PASS=edonation_secret
MYSQL_ROOT_PASSWORD=root_secret

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=docker-dev-secret-change-in-production
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=

# ===========================================
# CMU OAuth Configuration
# ===========================================
CMU_OAUTH_CLIENT_ID=
CMU_OAUTH_CLIENT_SECRET=
CMU_OAUTH_TENANT_ID=
