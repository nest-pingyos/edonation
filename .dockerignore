# eDonation Docker Ignore
# Files and directories to exclude from Docker build

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment files (build-time)
.env
.env.local
.env.*.local

# Docker files (not needed inside container)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
README*
CHANGELOG*
LICENSE

# Tests
tests/
*_test.php
local_test.php
production_test.php

# Development
.agent/
.gemini/
node_modules/
vendor/

# Logs
*.log
logs/

# Temp files
tmp/
temp/
cache/

# Admin build artifacts (keep only dist)
admin/node_modules/
admin/src/scss/
admin/*.json
admin/*.js
admin/*.lock*

# Database SQL files (loaded separately)
database/*.sql
