# eDonation Production Configuration
# สำหรับ deploy บน production server
# Last updated: 2025-12-23

# ===========================================
# Application Settings
# ===========================================
APP_ENV=production
APP_DEBUG=false

# ===========================================
# Domain & URL Configuration
# ===========================================
# Web/Admin Domain
APP_DOMAIN=https://app.nurse.cmu.ac.th

# API Domain (same as APP_DOMAIN for single-server setup)
# หากต้องการแยก API ไปอีก domain ให้เปลี่ยนเป็น:
# API_DOMAIN=https://api.nurse.cmu.ac.th
API_DOMAIN=https://app.nurse.cmu.ac.th

# Base paths
BASE_PATH=/edonation
API_BASE_PATH=/edonation/api

# CORS - Allowed origins (comma-separated)
# สำหรับ API แยก domain ให้เพิ่ม domain ที่อนุญาต
CORS_ALLOWED_ORIGINS=https://app.nurse.cmu.ac.th

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=edonation
DB_USER=edonation_user
DB_PASS=YOUR_SECURE_PASSWORD_HERE

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change to a secure random key!
JWT_SECRET=YOUR_PRODUCTION_SECRET_KEY_HERE
JWT_EXPIRE=86400

# ===========================================
# LINE Notify Integration
# ===========================================
LINE_TOKEN=YOUR_LINE_TOKEN_HERE

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=YOUR_APP_PASSWORD_HERE

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=YOUR_BILLER_ID
SCB_API_KEY=YOUR_API_KEY
SCB_API_SECRET=YOUR_API_SECRET
