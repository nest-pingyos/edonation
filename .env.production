# eDonation Production Environment Configuration
# ⚠️  IMPORTANT: Copy this file to .env on production server
# ⚠️  NEVER commit .env file to version control
# Last updated: 2026-01-28

# ===========================================
# Application Settings
# ===========================================
APP_ENV=production
APP_DEBUG=false

# ===========================================
# Domain & URL Configuration
# ===========================================
# Change to your actual production domain
APP_DOMAIN=https://your-domain.cmu.ac.th
API_DOMAIN=https://your-domain.cmu.ac.th

# Base path (change if app is not at root)
BASE_PATH=
API_BASE_PATH=/api

# ===========================================
# Database Configuration
# ===========================================
# ⚠️  Use strong password in production!
DB_HOST=localhost
DB_NAME=edonation_db
DB_USER=edonation_user
DB_PASS=CHANGE_TO_STRONG_PASSWORD

# ===========================================
# JWT Configuration (CRITICAL!)
# ===========================================
# ⚠️  Generate a new random secret using:
#     php -r "echo bin2hex(random_bytes(32));"
# 
# This MUST be a long random string (64+ characters)
JWT_SECRET=GENERATE_NEW_SECRET_WITH_COMMAND_ABOVE
JWT_EXPIRE=28800

# ===========================================
# Session Security
# ===========================================
SESSION_LIFETIME=28800
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# ===========================================
# LINE Notify Integration
# ===========================================
LINE_TOKEN=

# ===========================================
# Email Configuration (Gmail SMTP)
# ===========================================
GMAIL_USER=
GMAIL_PASS=

# ===========================================
# SCB PromptPay Configuration
# ===========================================
SCB_BILLER_ID=
SCB_API_KEY=
SCB_API_SECRET=

# ===========================================
# CMU OAuth Configuration (Microsoft Entra)
# ===========================================
# ⚠️  Keep these secret! Use the production app registration
CMU_OAUTH_CLIENT_ID=CHANGE_TO_PRODUCTION_CLIENT_ID
CMU_OAUTH_CLIENT_SECRET=CHANGE_TO_PRODUCTION_CLIENT_SECRET
CMU_OAUTH_TENANT_ID=CHANGE_TO_PRODUCTION_TENANT_ID
